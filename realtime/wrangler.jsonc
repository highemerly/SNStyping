{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snstyping-realtime",
  "main": "index.mjs",
  "compatibility_date": "2026-06-01",
  // 本番の URL（Cloudflare の piyo.me ゾーンのカスタムドメイン。wrangler deploy で DNS と証明書も作られる）。
  "routes": [{ "pattern": "realtime-snstyping.piyo.me", "custom_domain": true }],
  // workers.dev の URL も残す（ドメインを移す前に開いた画面がつながり続けるように）。
  // routes があると既定が変わりうるので明示する
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
    { "tag": "v3", "new_sqlite_classes": ["Stats"] }
  ],
  "vars": {
    "DICT_BASE_URL": "https://highemerly.github.io/snstyping-dict/"
  }
}
